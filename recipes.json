[
  {
    "id": "yu-tou-tang",
    "name": "鱼头汤",
    "emoji": "🐟",
    "category": "硬菜",
    "description": "奶白浓郁的鱼头汤，鲜美滋补，一碗暖到心里。",
    "prep_time": "15分钟",
    "cook_time": "40分钟",
    "servings": "3-4人份",
    "difficulty": "中等",
    "ingredients": [
      { "name": "花鲢鱼头", "amount": "1个", "note": "约600g" },
      { "name": "嫩豆腐", "amount": "1块", "note": "" },
      { "name": "姜片", "amount": "5-6片", "note": "" },
      { "name": "大葱", "amount": "2段", "note": "葱白" },
      { "name": "料酒", "amount": "2勺", "note": "" },
      { "name": "盐", "amount": "适量", "note": "" },
      { "name": "白胡椒粉", "amount": "少许", "note": "" },
      { "name": "食用油", "amount": "适量", "note": "" },
      { "name": "枸杞", "amount": "少许", "note": "可选" },
      { "name": "香菜", "amount": "少许", "note": "装饰用" }
    ],
    "steps": [
      "鱼头对半劈开，去除鱼鳃，清洗干净，用厨房纸巾擦干表面水分。",
      "锅中倒入适量油，中大火烧至七成热，放入鱼头煎至两面金黄，约每面3分钟。",
      "煎鱼头时放入姜片和葱段一起煸香。",
      "沿锅边淋入料酒，随后倒入足量开水（一定要用开水，这是汤色奶白的关键）。",
      "大火煮沸后保持大火滚煮10分钟，汤色开始变白。",
      "转中火继续煮20分钟，期间放入切块的豆腐。",
      "出锅前加盐和白胡椒粉调味，撒上枸杞和香菜即可。"
    ],
    "tips": [
      "鱼头一定要擦干再煎，否则容易粘锅和溅油。",
      "倒入开水而非冷水是汤色奶白的关键秘诀。",
      "全程保持中大火，小火炖出来的汤会偏清澈。",
      "豆腐不要太早放，容易煮散。"
    ]
  },
  {
    "id": "tang-cu-xiao-pai",
    "name": "糖醋小排",
    "emoji": "🍖",
    "category": "硬菜",
    "description": "色泽红亮、酸甜适口，外酥里嫩的经典上海味道。",
    "prep_time": "20分钟",
    "cook_time": "35分钟",
    "servings": "3-4人份",
    "difficulty": "中等",
    "ingredients": [
      { "name": "猪小排", "amount": "500g", "note": "让师傅剁小段" },
      { "name": "料酒", "amount": "2勺", "note": "" },
      { "name": "生抽", "amount": "2勺", "note": "" },
      { "name": "醋", "amount": "3勺", "note": "镇江香醋最佳" },
      { "name": "白糖", "amount": "3勺", "note": "" },
      { "name": "番茄酱", "amount": "2勺", "note": "" },
      { "name": "姜片", "amount": "3-4片", "note": "" },
      { "name": "葱段", "amount": "适量", "note": "" },
      { "name": "白芝麻", "amount": "少许", "note": "装饰用" },
      { "name": "食用油", "amount": "适量", "note": "" }
    ],
    "steps": [
      "小排冷水下锅，加姜片和料酒焯水，煮沸后撇去浮沫，捞出洗净沥干。",
      "调糖醋汁：碗中混合生抽2勺、醋3勺、白糖3勺、番茄酱2勺、清水小半碗，搅拌均匀备用。",
      "锅中倒油烧热，放入小排中火煎至表面微焦，约5-6分钟。",
      "倒入调好的糖醋汁，加入姜片和葱段，大火煮沸。",
      "转中小火加盖焖煮约25分钟，期间翻动几次防止粘锅。",
      "开盖转大火收汁，不断翻炒使酱汁均匀裹在排骨上，汁浓即可。",
      "装盘后撒上白芝麻点缀。"
    ],
    "tips": [
      "糖醋比例可根据个人口味微调，喜欢偏酸就多加点醋。",
      "焯水后一定要沥干水分，煎的时候才能上色。",
      "收汁时要不停翻炒，防止糖焦底。",
      "镇江香醋的风味最搭糖醋排骨，白醋会偏酸。"
    ]
  },
  {
    "id": "yan-xun-niu-xiao-pai",
    "name": "烟熏牛小排",
    "emoji": "🥩",
    "category": "硬菜",
    "description": "烟熏风味浓郁，肉质软嫩多汁，媲美西餐厅的硬核大菜。",
    "prep_time": "30分钟（腌制4小时）",
    "cook_time": "3小时",
    "servings": "4-6人份",
    "difficulty": "较难",
    "ingredients": [
      { "name": "牛小排", "amount": "1kg", "note": "带骨" },
      { "name": "烟熏辣椒粉", "amount": "2勺", "note": "" },
      { "name": "蒜粉", "amount": "1勺", "note": "" },
      { "name": "洋葱粉", "amount": "1勺", "note": "" },
      { "name": "黑胡椒碎", "amount": "1勺", "note": "" },
      { "name": "红糖", "amount": "2勺", "note": "" },
      { "name": "盐", "amount": "1.5勺", "note": "" },
      { "name": "酱油", "amount": "3勺", "note": "" },
      { "name": "蜂蜜", "amount": "2勺", "note": "" },
      { "name": "苹果醋", "amount": "1勺", "note": "" },
      { "name": "食用油", "amount": "适量", "note": "" }
    ],
    "steps": [
      "将烟熏辣椒粉、蒜粉、洋葱粉、黑胡椒碎、红糖和盐混合成干料。",
      "牛小排洗净擦干，均匀涂抹干料，用保鲜膜包好放冰箱腌制至少4小时（过夜更佳）。",
      "烤箱预热至150°C（300°F）。",
      "铸铁锅或烤盘中倒入少许油，大火将牛小排每面煎2分钟至表面焦褐。",
      "将酱油、蜂蜜、苹果醋混合，淋在牛小排上。",
      "用锡纸紧紧包裹牛小排，放入烤箱低温慢烤2.5-3小时。",
      "取出撕开锡纸，将烤盘汁液淋回肉上，不盖锡纸再烤15分钟使表面焦化。",
      "取出静置10分钟后切开装盘。"
    ],
    "tips": [
      "低温慢烤是关键，温度太高肉会发柴。",
      "腌制时间越长越入味，建议至少提前一晚准备。",
      "没有烟熏辣椒粉可以用普通辣椒粉+液体烟熏调味料替代。",
      "煎制封表面可以锁住肉汁，这一步不要省略。",
      "静置后再切可以防止肉汁流失。"
    ]
  },
  {
    "id": "ke-le-ji-chi",
    "name": "可乐鸡翅",
    "emoji": "🍗",
    "category": "家常菜",
    "description": "甜香入味、色泽诱人，大人小孩都爱的经典家常菜。",
    "prep_time": "10分钟",
    "cook_time": "25分钟",
    "servings": "2-3人份",
    "difficulty": "简单",
    "ingredients": [
      { "name": "鸡翅中", "amount": "12个", "note": "约500g" },
      { "name": "可乐", "amount": "1罐", "note": "330ml，用普通可乐" },
      { "name": "生抽", "amount": "3勺", "note": "" },
      { "name": "老抽", "amount": "1勺", "note": "上色用" },
      { "name": "料酒", "amount": "1勺", "note": "" },
      { "name": "姜片", "amount": "4-5片", "note": "" },
      { "name": "蒜瓣", "amount": "3-4瓣", "note": "拍碎" },
      { "name": "干辣椒", "amount": "2个", "note": "可选" },
      { "name": "食用油", "amount": "少许", "note": "" }
    ],
    "steps": [
      "鸡翅洗净，两面各划两刀方便入味。",
      "冷水下锅焯水，加姜片和料酒，煮沸后捞出洗净沥干。",
      "锅中倒少许油，放入鸡翅中火煎至两面金黄。",
      "放入姜片、蒜瓣和干辣椒翻炒出香味。",
      "倒入可乐，加入生抽和老抽，大火煮沸。",
      "转中小火加盖焖煮15-18分钟。",
      "开盖大火收汁，不断翻动鸡翅使酱汁均匀裹附，汁浓亮即可出锅。"
    ],
    "tips": [
      "一定要用普通可乐，零度或无糖可乐做不出粘稠的酱汁。",
      "鸡翅划刀可以更好地入味和缩短烹饪时间。",
      "收汁时注意火候，糖分高容易糊底。",
      "喜欢辣味可以多放干辣椒或加少许辣椒酱。"
    ]
  },
  {
    "id": "cheng-zhi-san-wen-yu",
    "name": "橙汁三文鱼",
    "emoji": "🍊",
    "category": "家常菜",
    "description": "清新的橙香与鲜嫩的三文鱼完美融合，健康又美味的轻食之选。",
    "prep_time": "10分钟",
    "cook_time": "15分钟",
    "servings": "2人份",
    "difficulty": "简单",
    "ingredients": [
      { "name": "三文鱼排", "amount": "2块", "note": "约300g" },
      { "name": "鲜橙", "amount": "2个", "note": "1个榨汁，1个切片装饰" },
      { "name": "蜂蜜", "amount": "1勺", "note": "" },
      { "name": "酱油", "amount": "1勺", "note": "" },
      { "name": "黄油", "amount": "15g", "note": "" },
      { "name": "蒜末", "amount": "1勺", "note": "" },
      { "name": "盐", "amount": "适量", "note": "" },
      { "name": "黑胡椒", "amount": "适量", "note": "" },
      { "name": "迷迭香", "amount": "1小枝", "note": "可选" }
    ],
    "steps": [
      "三文鱼用厨房纸巾擦干，两面撒盐和黑胡椒腌制5分钟。",
      "鲜橙榨汁，与蜂蜜和酱油混合成橙汁酱汁。",
      "平底锅中火融化黄油，放入三文鱼皮面朝下煎3-4分钟至皮酥脆。",
      "翻面继续煎2分钟，取出备用。",
      "同一锅中加入蒜末炒香，倒入橙汁酱汁煮沸。",
      "小火熬煮2-3分钟至酱汁稍微浓稠。",
      "将三文鱼放回锅中，用酱汁浇淋鱼身，煮1分钟。",
      "装盘后淋上锅中酱汁，用橙片和迷迭香装饰。"
    ],
    "tips": [
      "三文鱼不要煎过头，中间保持微粉色口感最嫩。",
      "用鲜榨橙汁风味远胜瓶装橙汁。",
      "煎鱼皮时不要急着翻面，等皮自然脱离锅底再翻。",
      "酱汁不需要太浓，保持轻盈的口感更搭配三文鱼。"
    ]
  },
  {
    "id": "sha-guo-yu",
    "name": "砂锅鱼",
    "emoji": "🍲",
    "category": "家常菜",
    "description": "砂锅慢炖出的鲜美鱼汤，配上软糯的粉丝和豆腐，暖身又暖胃。",
    "prep_time": "15分钟",
    "cook_time": "30分钟",
    "servings": "3-4人份",
    "difficulty": "中等",
    "ingredients": [
      { "name": "鲈鱼", "amount": "1条", "note": "约500g，处理干净" },
      { "name": "粉丝", "amount": "1把", "note": "提前泡软" },
      { "name": "嫩豆腐", "amount": "1块", "note": "切块" },
      { "name": "白菜", "amount": "3-4片", "note": "手撕" },
      { "name": "姜片", "amount": "5-6片", "note": "" },
      { "name": "大葱", "amount": "2段", "note": "" },
      { "name": "蒜瓣", "amount": "4-5瓣", "note": "" },
      { "name": "生抽", "amount": "2勺", "note": "" },
      { "name": "料酒", "amount": "2勺", "note": "" },
      { "name": "盐", "amount": "适量", "note": "" },
      { "name": "白胡椒粉", "amount": "少许", "note": "" },
      { "name": "食用油", "amount": "适量", "note": "" },
      { "name": "香菜", "amount": "少许", "note": "装饰" }
    ],
    "steps": [
      "鲈鱼处理干净，两面划花刀，用料酒和少许盐抹匀腌制10分钟。",
      "平底锅烧热倒油，将鱼两面煎至金黄，盛出备用。",
      "砂锅中倒入少许油，放入姜片、葱段和蒜瓣爆香。",
      "放入白菜垫底，铺上豆腐块。",
      "将煎好的鱼放在上面，加入开水没过鱼身。",
      "加入生抽，大火煮沸后转小火慢炖20分钟。",
      "放入泡软的粉丝，继续煮5分钟。",
      "加盐和白胡椒粉调味，撒上香菜，连砂锅一起上桌。"
    ],
    "tips": [
      "砂锅要提前预热，避免冷锅直接加热导致开裂。",
      "鱼先煎后炖可以保持形状完整不散。",
      "粉丝最后放，否则吸掉太多汤汁且容易粘锅底。",
      "用砂锅保温效果好，上桌后还能持续冒泡很有氛围感。"
    ]
  }
]
